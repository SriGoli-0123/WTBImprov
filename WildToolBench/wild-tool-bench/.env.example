# [OPTIONAL] Required for LLM generation step
# Provide the API key for the model(s) you intend to use
#
# .env is gitignored on purpose (real API keys should never be committed), so
# `git pull` never brings it over. For the local vLLM workflow (run_wtb_vllm.sh),
# the values below are NOT secrets - localhost + a fake token vLLM ignores
# unless started with --api-key - so just run once per machine:
#   cp .env.example .env
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=token-vllm
DEEPSEEK_API_KEY=sk-XXXXXX